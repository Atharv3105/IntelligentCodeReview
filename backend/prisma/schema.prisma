// ============================================================================
// AI Interview Intelligence Platform — Prisma Schema
// ============================================================================
// PostgreSQL database schema for the complete platform.
// Run: npx prisma migrate dev --name init
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  student
  admin
  interviewer
}

enum Difficulty {
  easy
  medium
  hard
}

enum SubmissionStatus {
  pending
  running
  completed
  failed
  timeout
}

enum AssessmentType {
  MCQ
  CODING
  SQL
  DOCUMENT
  MIXED
  AI_INTERVIEW
}

enum AttemptStatus {
  in_progress
  submitted
  flagged
  timed_out
}

enum InterviewType {
  technical
  coding
  behavioral
  hr
  system_design
  resume_based
  project_defense
}

enum InterviewState {
  created
  preparing
  active
  listening
  thinking
  follow_up
  next_question
  final_evaluation
  completed
  cancelled
}

enum QuestionType {
  coding
  mcq
  short_answer
  scenario
  system_design
  behavioral
  sql
}

enum MockTestStatus {
  draft
  active
  completed
}

enum StudyPlanDuration {
  seven_days
  fourteen_days
  thirty_days
}

enum AIProvider {
  openai
  gemini
  groq
}

enum AIRequestStatus {
  success
  failed
  timeout
  rate_limited
}

enum NotificationType {
  interview_complete
  report_ready
  study_plan_updated
  skill_improved
  recommendation
  achievement
  system
}

enum TestCaseCategory {
  public
  hidden
  edge
  stress
}

// ============================================================================
// USER & PROFILE
// ============================================================================

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  role              Role      @default(student)
  isVerified        Boolean   @default(false)
  verificationToken String?
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  profile           UserProfile?
  skills            UserSkill[]
  submissions       Submission[]
  interviewSessions InterviewSession[]
  mockTestAttempts  MockTestAttempt[]
  assessmentAttempts AssessmentAttempt[]
  sqlAttempts       SQLAttempt[]
  candidateMemory   CandidateMemory?
  studyPlans        StudyPlan[]
  resumes           Resume[]
  githubProfile     GitHubProfile?
  careerProfile     CareerProfile?
  achievements      Achievement[]
  activities        Activity[]
  notifications     Notification[]
  aiUsage           AIUsage[]
  integrityEvents   IntegrityEvent[]
  refreshTokens     RefreshToken[]

  @@index([email])
}

model UserProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetRole         String?       // e.g., "Software Engineer"
  experienceLevel    String?       // e.g., "Fresher", "1-3 years"
  preferredLanguage  String?       // e.g., "cpp", "python"
  institution        String?
  graduationYear     Int?
  bio                String?

  // Gamification
  xp                 Int      @default(0)
  level              Int      @default(1)
  streakCount        Int      @default(0)
  longestStreak      Int      @default(0)
  lastActiveDate     DateTime?

  // Readiness
  readinessScore     Float    @default(0)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============================================================================
// SKILLS
// ============================================================================

model Skill {
  id          String      @id @default(uuid())
  name        String      @unique  // e.g., "Arrays", "Dynamic Programming", "SQL"
  category    String                // e.g., "DSA", "SQL", "DBMS", "OS", "CN", "OOP", "System Design"
  description String?
  userSkills  UserSkill[]

  @@index([category])
}

model UserSkill {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  mastery     Float    @default(0)   // 0-100
  confidence  Float    @default(0)   // 0-1, statistical confidence
  attempts    Int      @default(0)
  successes   Int      @default(0)
  lastPracticed DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, skillId])
  @@index([userId])
}

// ============================================================================
// PROBLEMS & SUBMISSIONS
// ============================================================================

model Problem {
  id             String     @id @default(uuid())
  problemNumber  Int?       @unique
  title          String
  description    String
  difficulty     Difficulty
  category       String     @default("Algorithms")
  concept        String     @default("General")
  topics         String[]   // e.g., ["arrays", "two-pointers"]
  collections    String[]   // e.g., ["Blind75", "Neetcode150"]
  tags           String[]

  starterCode    Json?      // { cpp: "...", python: "...", java: "...", javascript: "..." }
  hints          String[]
  constraints    String[]
  expectedComplexity Json?  // { time: "O(n)", space: "O(n)" }

  isGenerated    Boolean    @default(false)
  isApproved     Boolean    @default(true)  // false for AI-generated pending validation

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  testCases      TestCase[]
  submissions    Submission[]
  generatedFrom  GeneratedQuestion?

  @@index([category])
  @@index([concept])
  @@index([difficulty])
}

model TestCase {
  id             String           @id @default(uuid())
  problemId      String
  problem        Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)

  input          String
  expectedOutput String
  category       TestCaseCategory @default(public)
  orderIndex     Int              @default(0)
  timeLimit      Int?             // ms
  memoryLimit    Int?             // KB

  createdAt      DateTime         @default(now())

  @@index([problemId])
}

model GeneratedQuestion {
  id             String   @id @default(uuid())
  problemId      String?  @unique
  problem        Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  // Generation metadata
  generationId   String   @unique @default(uuid())
  provider       AIProvider
  model          String
  promptVersion  String
  rawResponse    Json?

  // Validation
  isValidated    Boolean  @default(false)
  validationErrors String[]

  createdAt      DateTime @default(now())
}

model Submission {
  id             String           @id @default(uuid())
  problemId      String
  problem        Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  code           String
  language       String           @default("python")
  status         SubmissionStatus @default(pending)

  // Judge results
  passedTests    Int?
  totalTests     Int?
  runtime        Int?             // ms
  memory         Int?             // KB
  compileError   String?
  runtimeError   String?
  testResults    Json?            // detailed per-test results

  // AI review
  grade          Float?
  feedback       Json?
  plagiarismScore Float?

  // Complexity analysis
  timeComplexity  String?
  spaceComplexity String?
  complexityConfidence String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId])
  @@index([problemId])
  @@index([userId, problemId])
}

// ============================================================================
// INTERVIEWS
// ============================================================================

model InterviewSession {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           InterviewType
  state          InterviewState @default(created)
  title          String?

  // Configuration
  topics         String[]       // e.g., ["DSA", "OS", "DBMS"]
  difficulty     Difficulty     @default(medium)
  targetRole     String?
  experienceLevel String?
  duration       Int?           // planned duration in minutes
  questionCount  Int?

  // Timing
  startedAt      DateTime?
  completedAt    DateTime?
  totalDuration  Int?           // actual duration in seconds

  // Scoring
  overallScore   Float?
  technicalScore Float?
  communicationScore Float?
  problemSolvingScore Float?

  // Voice
  isVoiceEnabled Boolean        @default(false)
  voiceTranscript Json?         // full conversation transcript

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  questions      InterviewQuestion[]
  report         InterviewReport?

  @@index([userId])
  @@index([userId, createdAt])
}

model InterviewQuestion {
  id             String           @id @default(uuid())
  sessionId      String
  session        InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questionText   String
  questionType   QuestionType
  topic          String?
  difficulty     Difficulty       @default(medium)
  orderIndex     Int
  expectedAnswer String?          // AI-generated expected answer points

  // For coding questions
  starterCode    Json?
  testCases      Json?

  createdAt      DateTime         @default(now())

  // Relations
  answer         InterviewAnswer?
  followUps      InterviewFollowUp[]

  @@index([sessionId])
}

model InterviewAnswer {
  id             String            @id @default(uuid())
  questionId     String            @unique
  question       InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answerText     String?
  code           String?           // for coding questions
  codeLanguage   String?
  duration       Int?              // seconds taken to answer

  // AI evaluation
  score          Float?
  evaluation     Json?             // detailed AI evaluation
  strengths      String[]
  weaknesses     String[]

  createdAt      DateTime          @default(now())
}

model InterviewFollowUp {
  id             String            @id @default(uuid())
  questionId     String
  question       InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  followUpText   String
  answerText     String?
  score          Float?
  evaluation     Json?
  orderIndex     Int

  createdAt      DateTime          @default(now())

  @@index([questionId])
}

model InterviewReport {
  id             String           @id @default(uuid())
  sessionId      String           @unique
  session        InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Scores
  overallScore   Float
  technicalScore Float?
  codingScore    Float?
  problemSolvingScore Float?
  communicationScore Float?
  conceptualScore Float?

  // Qualitative
  strengths      String[]
  weaknesses     String[]
  recommendations String[]
  detailedFeedback Json?

  // Next steps
  suggestedTopics String[]
  suggestedDifficulty Difficulty?
  nextInterviewType InterviewType?

  generatedAt    DateTime         @default(now())
}

// ============================================================================
// MOCK TESTS
// ============================================================================

model MockTest {
  id             String         @id @default(uuid())
  title          String
  description    String?

  // Configuration
  targetRole     String?
  difficulty     Difficulty     @default(medium)
  duration       Int            // minutes
  questionCount  Int
  topicWeights   Json?          // { "DSA": 40, "SQL": 20, ... }
  isAdaptive     Boolean        @default(false)
  status         MockTestStatus @default(draft)

  createdBy      String?        // admin user ID or "system"
  isGenerated    Boolean        @default(false)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  questions      MockTestQuestion[]
  attempts       MockTestAttempt[]
}

model MockTestQuestion {
  id             String     @id @default(uuid())
  mockTestId     String
  mockTest       MockTest   @relation(fields: [mockTestId], references: [id], onDelete: Cascade)

  questionText   String
  questionType   QuestionType
  topic          String?
  difficulty     Difficulty @default(medium)
  orderIndex     Int
  points         Int        @default(10)

  // MCQ fields
  options        String[]
  correctAnswer  Int?       // index for MCQ
  explanation    String?

  // Coding fields
  starterCode    Json?
  testCases      Json?
  expectedComplexity Json?

  createdAt      DateTime   @default(now())

  @@index([mockTestId])
}

model MockTestAttempt {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTestId     String
  mockTest       MockTest   @relation(fields: [mockTestId], references: [id], onDelete: Cascade)

  startedAt      DateTime   @default(now())
  completedAt    DateTime?
  expiresAt      DateTime

  score          Float?
  totalPoints    Int?
  percentage     Float?
  topicScores    Json?      // { "DSA": 80, "SQL": 60, ... }
  answers        Json?      // array of per-question answers

  // Adaptive tracking
  estimatedSkill Float?
  difficultyProgression Json?  // array of difficulty changes

  status         AttemptStatus @default(in_progress)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId])
  @@index([mockTestId])
}

// ============================================================================
// ASSESSMENTS (Admin-created assessments)
// ============================================================================

model Assessment {
  id             String         @id @default(uuid())
  title          String
  description    String?
  type           AssessmentType
  startTime      DateTime
  endTime        DateTime
  duration       Int            // minutes

  externalUrl    String?        // for Google Forms MCQ
  settings       Json?          // { allowCopy, enforceFullScreen, maxTabSwitches, ... }

  createdBy      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  questions      AssessmentQuestion[]
  attempts       AssessmentAttempt[]
}

model AssessmentQuestion {
  id             String     @id @default(uuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  problemId      String?    // reference to Problem for coding questions
  questionText   String?    // for MCQ/theory questions
  questionType   QuestionType
  orderIndex     Int
  points         Int        @default(10)

  // MCQ fields
  options        String[]
  correctAnswer  Int?

  createdAt      DateTime   @default(now())

  @@index([assessmentId])
}

model AssessmentAttempt {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId     String
  assessment       Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  startedAt        DateTime     @default(now())
  expiresAt        DateTime
  completedAt      DateTime?

  status           AttemptStatus @default(in_progress)
  submissionFile   String?      // for document type
  isExternalSubmitted Boolean   @default(false)

  // Results
  answers          Json?        // per-question answers and submissions
  grade            Float?
  feedback         Json?

  // Proctoring
  violations       Json?        // array of { type, timestamp, details }
  violationCount   Int          @default(0)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([userId, assessmentId])
  @@index([userId])
  @@index([assessmentId])
}

// ============================================================================
// SQL LAB
// ============================================================================

model SQLChallenge {
  id             String     @id @default(uuid())
  title          String
  description    String
  difficulty     Difficulty @default(medium)
  topic          String?    // e.g., "joins", "aggregation", "window functions"

  // Schema definition
  setupSQL       String     // CREATE TABLE + INSERT statements
  solutionSQL    String     // expected query
  expectedResult Json?      // expected result set

  // AI generation metadata
  isGenerated    Boolean    @default(false)
  generationId   String?

  hints          String[]
  explanation    String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  attempts       SQLAttempt[]

  @@index([difficulty])
  @@index([topic])
}

model SQLAttempt {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId    String
  challenge      SQLChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  query          String
  result         Json?        // actual query result
  isCorrect      Boolean?
  executionTime  Int?         // ms
  error          String?

  // AI feedback
  feedback       Json?
  score          Float?

  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([challengeId])
}

// ============================================================================
// CAREER & PERSONALIZATION
// ============================================================================

model CandidateMemory {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetRole        String?
  preferredLanguage String?
  strengths         String[]
  weaknesses        String[]
  topicsToImprove   String[]
  recentMistakes    Json?    // array of recent mistake patterns
  careerGoal        String?
  availableStudyTime String?
  interviewDate     DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model StudyPlan {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String
  duration       StudyPlanDuration
  targetRole     String?
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean           @default(true)

  // AI generation metadata
  generationId   String?
  provider       AIProvider?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relations
  items          StudyPlanItem[]

  @@index([userId])
}

model StudyPlanItem {
  id             String    @id @default(uuid())
  planId         String
  plan           StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  dayNumber      Int
  title          String
  description    String?
  type           String    // e.g., "practice", "interview", "review", "mock_test"
  topic          String?
  difficulty     Difficulty?
  estimatedTime  Int?      // minutes
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?

  @@index([planId])
}

model Resume {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  filename       String   // secure random filename
  originalName   String   // original upload name (display only)
  mimeType       String
  size           Int      // bytes
  storagePath    String   // relative path in storage/resumes/

  // Parsed data
  parsedData     Json?    // { skills, education, projects, experience, technologies, achievements }
  atsScore       Float?   // estimated ATS compatibility score
  analysis       Json?    // { strengths, weaknesses, missingSkills, suggestions }

  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model GitHubProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  githubUsername  String
  profileUrl     String?
  avatarUrl      String?

  // Analysis
  repositories   Json?    // array of repo summaries
  languages      Json?    // language breakdown
  contributions  Json?    // contribution activity
  analysis       Json?    // AI analysis of profile

  lastAnalyzed   DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CareerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentRole    String?
  targetRole     String?
  industry       String?
  yearsExperience Int?

  roadmap        Json?    // AI-generated career roadmap
  skillGaps      Json?    // identified skill gaps
  recommendations Json?   // AI recommendations

  lastUpdated    DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================================
// GAMIFICATION & ACTIVITY
// ============================================================================

model Achievement {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           String   // e.g., "streak_7", "problems_50", "first_interview"
  title          String
  description    String?
  icon           String?
  xpAwarded      Int      @default(0)
  unlockedAt     DateTime @default(now())

  @@unique([userId, type])
  @@index([userId])
}

model Activity {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           String   // e.g., "problem_solved", "interview_completed", "mock_test_taken"
  title          String
  metadata       Json?    // additional context
  xpEarned       Int      @default(0)

  date           DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           NotificationType
  title          String
  message        String
  data           Json?            // additional metadata
  isRead         Boolean          @default(false)

  createdAt      DateTime         @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// ============================================================================
// AI USAGE & MONITORING
// ============================================================================

model AIUsage {
  id             String          @id @default(uuid())
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  provider       AIProvider
  model          String
  requestType    String          // e.g., "question_generation", "code_evaluation", "interview_followup"
  promptVersion  String?

  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  latency        Int?            // ms
  estimatedCost  Float?          // USD

  status         AIRequestStatus
  errorMessage   String?

  createdAt      DateTime        @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([provider])
}

model IntegrityEvent {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventType      String   // e.g., "tab_switch", "fullscreen_exit", "copy_paste"
  sessionId      String?  // interview or assessment session
  sessionType    String?  // "interview", "assessment", "mock_test"
  details        Json?
  timestamp      DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
}

// ============================================================================
// AUTH
// ============================================================================

model RefreshToken {
  id             String   @id @default(uuid())
  token          String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([token])
}
